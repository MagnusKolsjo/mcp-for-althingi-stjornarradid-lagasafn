# =============================================================================
# MCP-server för isländsk riksdags- och rättsdata
# Konfigurationsmall: kopiera till .env och fyll i dina värden
# .env ska aldrig checkas in i Git
# =============================================================================

# -----------------------------------------------------------------------------
# MCP-transport
# -----------------------------------------------------------------------------

# Transportläge: stdio (lokal MCP-klient) eller http (delad drift)
MCP_TRANSPORT=stdio

# HTTP-transport: adress och port (används bara när MCP_TRANSPORT=http)
MCP_HOST=127.0.0.1
MCP_PORT=8006

# API-nyckel för Bearer-token-autentisering i HTTP-läget. Obligatorisk —
# uppstart i http-läge avbryts (exitkod 2) om nyckeln saknas.
# Generera med: python3 -c "import secrets; print(secrets.token_hex(32))"
MCP_API_KEY=

# -----------------------------------------------------------------------------
# Databas
# -----------------------------------------------------------------------------

# PostgreSQL (rekommenderas — krävs för semantisk sökning med pgvector):
DATABASE_URL=postgresql://<ANVÄNDARE>:<LÖSENORD>@localhost:5432/<DATABASNAMN>

# SQLite — enklare, ingen serverinstallation:
# Avkommentera och ta bort DATABASE_URL ovan för att använda SQLite.
# DATABASE_URL=sqlite:///island_cache.db


# -----------------------------------------------------------------------------
# Alþingi — åtkomst till althingi.is (valfritt)
# -----------------------------------------------------------------------------

# althingi.is ligger bakom Cloudflare. Mellan 2026-05-18 och september 2026
# blockerades alla automatiserade anrop (HTTP 403); sedan 2026-09-24 går
# anropen igenom med projektets egen User-Agent. Lämna båda tomma i
# normaldrift.
#
# ALTHINGI_USER_AGENT ersätter projektets User-Agent.
# ALTHINGI_CF_CLEARANCE skickar en cf_clearance-cookie från en egen
# webbläsarsession; klienten väljer då TLS-profil efter User-Agent-strängen
# (Safari → safari17_0, Chrome → chrome124).
ALTHINGI_CF_CLEARANCE=
ALTHINGI_USER_AGENT=

# -----------------------------------------------------------------------------
# PDF-extraktion — minnesvakt, OCR-språk och OCR-kö (pdftext_skydd.py)
# -----------------------------------------------------------------------------

# Tesseract-språk för sidor utan textlager. isl+eng täcker isländska rit og
# skýrslur (standard om variabeln saknas).
# IS_OCR_SPRAK=isl+eng

# Minnesgräns i MB per PDF-extraktionsblock. Passeras gränsen avbryts blocket
# och läses om med ren textutvinning (utan layout och OCR).
# IS_PDF_MAX_MINNE_MB=3000

# Tidsgräns i sekunder per sidblock.
# IS_PDF_TIDSGRANS_S=300

# Antal sidor per extraktionsblock.
# IS_PDF_SIDBLOCK=20

# Mapp för OCR-kön (dokument där sidor saknade textlager, eller där ett block
# föll tillbaka på ren textutvinning). Standard: ocr_ko/ bredvid pdftext_skydd.py.
# IS_OCR_KO_MAPP=ocr_ko

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------

# Bästa tillgängliga modell för isländska (768 dim, tränad på CC-100 inkl. isländska)
# Inga mogna isländska SBERT-modeller finns i nuläget — multilingual-e5-base är valt alternativ.
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Sökbredd i HNSW-indexet (per fråga). Högre ger bättre träffsäkerhet och
# långsammare sökning; 100 ger i praktiken samma topp-10 som exakt sökning.
# IS_HNSW_EF_SEARCH=100

# Gäller bara en databas som ännu lagrar embeddings som vector med IVFFlat
# (före 05_konvertera_vektorer.py). Högre värde läser fler vektorer per fråga.
# IS_IVFFLAT_PROBES=1

# -----------------------------------------------------------------------------
# Query-expansion (valfritt)
# -----------------------------------------------------------------------------

# Aktivera LLM-baserad termexpansion för isländsk parlamentarisk och juridisk terminologi.
# Expanderar söktermen med synonymer och relaterade isländska termer innan sökning.
QUERY_EXPANSION_ENABLED=false

# OpenAI-kompatibel endpoint (till exempel Anthropic, OpenAI eller lokal Ollama).
# Modellnamnet anges alltid här; servern har inget förval.
QUERY_EXPANSION_BASE_URL=
QUERY_EXPANSION_API_KEY=
QUERY_EXPANSION_MODEL=<modellnamn>

# Sökväg till promptfil för termexpansion (standard: prompts/expansion_prompt.txt)
# QUERY_EXPANSION_PROMPT_FILE=prompts/expansion_prompt.txt
